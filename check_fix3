import numpy as np
import pandas as pd
from src.preprocessing import PreprocessingConfig, preprocess_single_series

rng = np.random.default_rng(0)
idx = pd.bdate_range("2024-01-01", periods=120)
prices = pd.Series(100 * np.exp(np.cumsum(rng.normal(0, 0.01, 120))), index=idx)

def run(**kw):
    return preprocess_single_series(prices, PreprocessingConfig(**kw))[0]

exp_w = np.log(prices.resample("W").last()).diff().dropna()
got_w = run(base_representation="log_returns", downsample_freq="W")
exp_s = np.log(prices.iloc[::5]).diff().dropna()
got_s = run(base_representation="log_returns", downsample_step=5)
exp_r = prices.iloc[::5]
got_r = run(base_representation="raw", downsample_step=5)
exp_n = np.log(prices).diff().dropna()
got_n = run(base_representation="log_returns")

def cmp(name, got, exp):
    got, exp = got.reset_index(drop=True), exp.reset_index(drop=True)
    same_len = len(got) == len(exp)
    diff = float(np.abs(got.values - exp.values).max()) if same_len else float("nan")
    print(f"{name:<28} len got/exp = {len(got)}/{len(exp)}  max|diff| = {diff:.2e}")

cmp("weekly log-returns (freq=W)", got_w, exp_w)
cmp("step=5 log-returns", got_s, exp_s)
cmp("raw, step=5 (unchanged)", got_r, exp_r)
cmp("no downsampling (unchanged)", got_n, exp_n)