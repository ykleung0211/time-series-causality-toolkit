from src.preprocessing import PreprocessingConfig

cases = {
    "A moving_average, no window  (should raise)": dict(smoothing_method="moving_average"),
    "B moving_average, window=0   (should raise)": dict(smoothing_method="moving_average", smoothing_window=0),
    "C moving_average, window=5   (ok)": dict(smoothing_method="moving_average", smoothing_window=5),
    "D window=5, method None      (ok)": dict(smoothing_window=5),
    "E raw + standardize          (ok)": dict(base_representation="raw", standardize=True),
    "F gaussian, no window        (raises already)": dict(smoothing_method="gaussian"),
    "G gaussian, window=5, sigma=1 (ok)": dict(smoothing_method="gaussian", smoothing_window=5, smoothing_sigma=1.0),
}
for name, kw in cases.items():
    try:
        PreprocessingConfig(**kw)
        print(f"{name:<46} -> OK (no error)")
    except ValueError as e:
        print(f"{name:<46} -> ValueError: {e}")